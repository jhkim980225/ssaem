# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM 답변 생성 — ANTHROPIC_API_KEY 우선, 없으면 GEMINI_API_KEY(무료 티어) 폴백
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# 임베딩 (선택) — OPENAI_API_KEY 우선, 없으면 GEMINI_API_KEY. 둘 다 없으면 키워드 검색 폴백.
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
GEMINI_EMBED_MODEL=gemini-embedding-001

# 학원 (단일 학원 배포 기준)
DEFAULT_ACADEMY_SLUG=default
DEFAULT_ACADEMY_NAME=우리학원

# 강사 가입 초대코드 — 미설정 시 가입이 열림 (개발 모드). 운영에선 필수.
INVITE_CODE=your-invite-code

# 시드 계정 비밀번호 (scripts/seed.ts, 8자 이상)
SEED_PASSWORD=12345678
